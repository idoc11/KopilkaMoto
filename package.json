{
  "name": "kopilkamoto",
  "version": "6.8.1",
  "private": true,
  "description": "PWA-трекер накоплений на мотоцикл",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint . && prettier --check . && html-validate index.html",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:coverage && npm run test:e2e:coverage",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=75 --test-coverage-include=js/core.js \"tests/unit/*.test.mjs\" && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=75 --test-coverage-include=js/storage.js \"tests/unit/*.test.mjs\"",
    "test:e2e:coverage": "node scripts/e2e-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "playwright": "1.63.0",
    "prettier": "3.10.1"
  }
}
